<?xml version="1.0" encoding="utf-8"?>
<!-- 점선 테두리 카드 (모서리 20dp, 연한 초록 바탕). "내 코스 만들기"처럼 새로 만드는 곳에 쓴다 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/tour_mint" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/tour_bar"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
</shape>
