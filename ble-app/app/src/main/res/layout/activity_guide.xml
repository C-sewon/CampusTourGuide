<?xml version="1.0" encoding="utf-8"?>
<!-- 가이드 (#64). 앱 사용법과 개인정보 안내. 서버 없이 글만 있는 화면이고, 장소 이름은 코스 데이터에서 읽는다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tour_background"
    android:orientation="vertical"
    tools:context=".GuideActivity">

    <!-- 상단 제목 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_title"
            android:textColor="@color/tour_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 묶음(item_guide_section.xml)이 여기에 들어간다 -->
        <LinearLayout
            android:id="@+id/guideList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/guide_intro"
                android:textColor="@color/tour_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_tour_tabs" />
</LinearLayout>
