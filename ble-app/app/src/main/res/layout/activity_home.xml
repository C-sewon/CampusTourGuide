<?xml version="1.0" encoding="utf-8"?>
<!-- 홈(탐색) 화면. 설계 문서 4장 "화면 1. 탐색(홈)" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tour_background"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <!-- 상단: 앱 이름 + 자동 감지 상태 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 길게 누르면 서버 주소 설정 (개발용) -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_app_title"
            android:textColor="@color/tour_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAutoDetect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tour_chip"
            android:backgroundTint="@color/tour_mint"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/home_auto_detect"
            android:textColor="@color/tour_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- 인사말 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/home_headline"
                android:textColor="@color/tour_text"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_subline"
                android:textColor="@color/tour_text_secondary"
                android:textSize="13sp" />

            <!-- 자동 감지 배너 (프로토타입과 같음). 실제 상태는 지유님 스캔 기능과 연결할 예정 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tour_round16"
                android:backgroundTint="@color/tour_mint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvAutoDetectBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/home_auto_detect"
                    android:textColor="@color/tour_text"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/ic_tour_bt"
                    app:drawableTint="@color/tour_primary" />

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tour_oval"
                    android:backgroundTint="@color/tour_blue_bg">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tour_bt"
                        app:tint="@color/tour_blue" />
                </FrameLayout>
            </LinearLayout>

            <!-- 캠퍼스 지도 (OpenStreetMap). 센서 위치를 온도 색으로 표시 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMap"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/tour_placeholder"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/home_map_description" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 추천 코스 카드 (서버 GET /api/courses/recommend) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecommend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/tour_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_tour_box"
                            android:backgroundTint="@color/tour_mint">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_tour_route" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvRecommendTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textColor="@color/tour_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="추천 코스: 짧은 그늘 코스" />
                    </LinearLayout>

                    <!-- 추천 이유 줄. 덥다/춥다는 주황, 쾌적은 초록, 모름은 회색 -->
                    <LinearLayout
                        android:id="@+id/rowReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tour_box"
                        android:backgroundTint="@color/tour_warm_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:id="@+id/ivReason"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tour_sun" />

                        <TextView
                            android:id="@+id/tvReason"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/tour_warm_text"
                            android:textSize="13sp"
                            tools:text="지금 31°C · 더운 날엔 핵심 코스를 추천해요" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/tour_divider" />

                    <TextView
                        android:id="@+id/tvRecommendMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/tour_text_secondary"
                        android:textSize="13sp"
                        tools:text="도보 약 12분 · 장소 2곳" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartTour"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/tour_primary"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/home_start_tour"
                android:textColor="@color/tour_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_tour_arrow"
                app:iconGravity="end"
                app:iconTint="@color/tour_on_primary" />
        </LinearLayout>
    </ScrollView>

    <!-- 하단 탭: 탐색 / 코스 / 내 투어 -->
    <include layout="@layout/view_tour_tabs" />
</LinearLayout>
