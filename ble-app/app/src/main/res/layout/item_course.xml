<?xml version="1.0" encoding="utf-8"?>
<!-- 코스 카드 하나. 고른 카드는 진한 테두리 (CourseActivity 가 정한다) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/tour_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/tour_primary"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCourseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tour_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="짧은 그늘 코스" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tour_chip"
                android:backgroundTint="@color/tour_warm_bg"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/tour_warm_chip_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="더운 날 추천"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCourseMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/tour_text_secondary"
            android:textSize="13sp"
            tools:text="총 9분 · 장소 2곳" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="@color/tour_bar"
                app:trackColor="@color/tour_bar_track"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/tour_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="0/2 방문" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
