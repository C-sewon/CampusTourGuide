<?xml version="1.0" encoding="utf-8"?>
<!-- 장소 안내 화면 (프로토타입 "장소 안내"). 도착 배너, 장소 그림, 이름, 현재 온도, 소개, 다음 장소, 도착/다음 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tour_background"
    android:orientation="vertical"
    tools:context=".SpotActivity">

    <!-- 상단: 뒤로, 화면 이름, 진행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/spot_back"
            android:padding="11dp"
            android:src="@drawable/ic_tour_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/spot_title"
            android:textColor="@color/tour_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tour_text_secondary"
            android:textSize="14sp"
            tools:text="01 / 04" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- 도착 배너. 대기(점선) / 도착 버튼 안내(진한 테두리) / 도착함(민트) -->
            <LinearLayout
                android:id="@+id/rowBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tour_banner_wait"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:id="@+id/bannerIconBg"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_tour_oval"
                    android:backgroundTint="@color/tour_blue_bg">

                    <ImageView
                        android:id="@+id/bannerIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tour_bt" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tour_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="장소에 가까워지고 있어요" />

                    <TextView
                        android:id="@+id/tvBannerSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/tour_banner_sub"
                        android:textSize="12sp"
                        tools:text="가까이 가면 도착을 자동으로 인식해요." />
                </LinearLayout>
            </LinearLayout>

            <!-- 지도: 내 위치(없으면 이전 장소) → 지금 가야 할 장소를 선으로 잇는다. 좌표가 없는 장소면 건물 그림 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMap"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/tour_illustration_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/spot_map_description" />

                <ImageView
                    android:id="@+id/ivIllustration"
                    android:layout_width="200dp"
                    android:layout_height="118dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ill_tour_building"
                    android:visibility="gone" />

                <!-- 내 위치가 잡히면 남은 거리 -->
                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_tour_chip"
                    android:elevation="2dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/tour_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="남은 거리 약 120m"
                    tools:visibility="visible" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 장소 이름 + 방문 상태 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSpotName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tour_text"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    tools:text="도서관 뒤편" />

                <TextView
                    android:id="@+id/tvVisit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:background="@drawable/bg_tour_chip_line"
                    tools:text="방문 완료" />
            </LinearLayout>

            <!-- 이 장소의 현재 온도. 값이 없으면 점선 회색 카드 -->
            <LinearLayout
                android:id="@+id/cardTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tour_card"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:id="@+id/tempTile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_tour_box"
                    android:backgroundTint="@color/tour_warm_bg">

                    <ImageView
                        android:id="@+id/tempIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tour_therm" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spot_now"
                        android:textColor="@color/tour_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tour_text"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        tools:text="21°C" />

                    <TextView
                        android:id="@+id/tvTempSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/tour_text_secondary"
                        android:textSize="12sp"
                        tools:text="이 장소 센서 · 3분 전 측정" />
                </LinearLayout>
            </LinearLayout>

            <!-- 소개 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/spot_about"
                android:textColor="@color/tour_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpotDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/tour_text_secondary"
                android:textSize="13sp"
                tools:text="[샘플] 진로창업본부 입구가 있는 곳." />

            <!-- 다음 장소 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tour_round16"
                android:backgroundTint="@color/tour_next_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spot_next"
                        android:textColor="@color/tour_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvNextName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/tour_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="사회과학대 입구" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNextWalk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/tour_text_secondary"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_tour_walk"
                    app:drawableTint="@color/tour_text_secondary"
                    tools:text="도보 3분" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 하단: 도착 / 다음 장소로. 순서와 크기는 SpotActivity 가 장소에 따라 정한다 -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArrive"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="0.8"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:iconGravity="textStart"
            tools:text="도착" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_tour_arrow"
            app:iconGravity="textEnd"
            tools:text="다음 장소로" />
    </LinearLayout>
</LinearLayout>
