# 서버 설정 예시. 이 파일을 .env 로 복사해서 값을 바꿔 쓴다. (.env 는 저장소에 올리지 않는다)
#
#   copy .env.example .env
#   uvicorn app.main:app --host 0.0.0.0 --port 8000 --env-file .env
#
# 아래 값은 모두 기본값이다. 바꿀 것이 없으면 .env 없이 서버를 켜도 같게 동작한다.

# DB 주소. 기본은 프로젝트 폴더의 campus_tour.db
DATABASE_URL=sqlite:///./campus_tour.db

# 연구실 센서 데이터 연동. 연구실 서버에 접속할 수 없는 곳이면 LAB_SYNC_ENABLED=0 으로 끈다
LAB_SYNC_ENABLED=1
LAB_SYNC_URL=http://203.255.81.72:10021/sensor/api/map
LAB_SYNC_SECONDS=60
LAB_SYNC_TIMEOUT=10

# 값 판정 기준
# 장소에 쓸 센서 값이 없을 때 가까운 센서 값을 빌려 쓰는 최대 거리(m)
MAX_BORROW_METERS=200
STALE_MINUTES=30
FIXED_VALUE_MIN_COUNT=5
FIXED_VALUE_MINUTES=10
AVG_WINDOW_MINUTES=30
COLD_MAX_CELSIUS=5
HOT_MIN_CELSIUS=27
